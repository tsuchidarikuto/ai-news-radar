GEMINI_API_KEY=
NOTION_API_KEY=
NOTION_DATABASE_ID=
SLACK_WEBHOOK_URL=
# Teams は Workflows (Power Automate) の webhook URL。両方設定すれば両方に送る
# TEAMS_WEBHOOK_URL=
# Teams で Markdown が描画されると確認できたら 1 にする（既定は記法なしの素のテキスト）
# TEAMS_MARKDOWN=1

# Optional: Google Alerts RSS feeds
# GOOGLE_ALERTS_RSS_1=https://www.google.com/alerts/feeds/...
# GOOGLE_ALERTS_RSS_2=https://www.google.com/alerts/feeds/...

# Optional: Gemini model override (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite
